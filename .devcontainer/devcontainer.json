{
  "name": "i2 Analyze on Azure",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // az + bicep for scripts/10-deploy-infra.sh and the pipeline stages
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    // ADT runs in its own dev container and builds liberty_configured_redhat into the
    // host daemon; scripts/30-build-images.sh tags + pushes that image, so share the host daemon
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-azurecli",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "ms-azure-devops.azure-pipelines",
        "timonwong.shellcheck"
      ]
    }
  }
}
