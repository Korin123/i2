{
  // Full build environment: i2's ADT dev image (builds the configured Liberty image,
  // generates DB scripts / Solr schemas) plus the Azure tooling (az, Bicep, kubectl,
  // kubelogin) that pushes to ACR and deploys to AKS. Based on ADT's own .devcontainer (v3.2.2).
  //
  // OPEN FROM WSL 2 (or macOS/Linux), i.e. a clone under /home/<you>. ADT bind-mounts workspace
  // paths into the containers it starts, so the workspace sits at the same path inside and
  // outside the container. A Windows path (D:\...) is not a valid container path and VS Code
  // shows a blank window - use the "Azure tools" configuration for a Windows checkout.
  "name": "i2 - ADT + Azure (open from WSL)",
  "image": "i2group/i2eng-analyze-containers-dev:1.2",
  "remoteUser": "vscode",
  "runArgs": [ "--init" ],
  "overrideCommand": false,
  "mounts": [
    // ADT drives the host Docker daemon; images it builds are then pushed from here
    "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind",
    // keep az login across rebuilds
    "source=i2-azure-config,target=/home/vscode/.azure,type=volume"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "DEVCONTAINER": "true",
    "DOCKER_BUILDKIT": "1",
    "HOST_HOME": "${localEnv:HOME}",
    // ADT is installed into adt/ (git-ignored) by scripts/05-install-adt.sh
    "WORKSPACE": "${containerWorkspaceFolder}/adt",
    "ANALYZE_CONTAINERS_ROOT_DIR": "${containerWorkspaceFolder}/adt",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:${containerWorkspaceFolder}/adt/scripts"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-azurecli",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azure-devops.azure-pipelines",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "vscjava.vscode-java-pack",
        "timonwong.shellcheck"
      ],
      "settings": {
        "remote.autoForwardPorts": false
      }
    }
  }
}
