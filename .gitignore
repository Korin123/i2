# Secrets and local env - never commit
*.env
.env
.env.*
env.sh
scripts/env.sh
scripts/env.sh.*
# ADT's dev container env-file: committed empty, as in ADT (docker run --env-file needs it)
!/.devcontainer/adt/devcontainer.env
!*.env.example
# Organisation root CAs for the dev container (see .devcontainer/certs/README.md)
/.devcontainer/certs/*
!/.devcontainer/certs/README.md
secrets/
*.pfx
*.pem
*.key
*.cer
kubeconfig*
# Bicep build output
*.json.bicep
bicep/**/*.json
# Node / tooling
node_modules/
# i2 licensed distribution - obtained separately under i2 licence, never committed
config/distribution/
*.tar.gz

# ADT installed locally by scripts/05-install-adt.sh (includes the licensed toolkit in pre-reqs/)
/adt/

# Solr configsets generated at build time by scripts/30-build-images.sh
images/solr-init/generated_config/
# Information Store scripts generated at build time by scripts/30-build-images.sh
images/db-init/generated/
# Assembled i2 configuration copied in at build time by scripts/30-build-images.sh
images/i2-tools/configuration/
