# Copy to env.sh and fill in. Never commit env.sh (see .gitignore).
# Resource names (resource group, Key Vault, ACR, AKS, workload identity, SQL MI) are NOT
# set here: Bicep names and creates them, and the scripts read them from the infra
# deployment's outputs. Set one here only to override it.
export SUBSCRIPTION_ID="<SUBSCRIPTION_ID>"
export LOCATION="uksouth"
export I2_ENV="dev"          # uses bicep/parameters/<I2_ENV>.bicepparam and deployment i2-infra-<I2_ENV>
export I2_VERSION="4.4.6.1"
export ADT_VERSION="3.2.2"
# export ALLOWED_TEST_IPS="<your public IP>"   # optional, for running scripts/10 locally: curl -s ifconfig.me
